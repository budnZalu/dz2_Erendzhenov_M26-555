[316.854585, "o", "databa"]
[316.86113, "o", "se\r\n"]
[317.559162, "o", "\r\n***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\nТипы данных: int, str, bool. Столбец ID:int добавляется автоматически.\r\n\r\n"]
[317.559189, "o", ">>>Введите команду: "]
[319.155485, "o", "create_table users name:str age:int is_active:bool\r\n"]
[319.161977, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[319.162912, "o", ">>>Введите команду: "]
[386.279231, "o", "list_tables\r\n"]
[386.283863, "o", "- users\r\n"]
[386.284625, "o", ">>>Введите команду: "]
[389.652585, "o", "exit\r\n"]
[389.653023, "o", "Выход из программы.\r\n"]
[389.663589, "o", "bash-3.2$ "]
[392.701996, "o", "database\r\n"]
[392.771626, "o", "\r\n***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\nТипы данных: int, str, bool. Столбец ID:int добавляется автоматически.\r\n\r\n"]
[392.771839, "o", ">>>Введите команду: "]
[394.949105, "o", "list_tables\r\n"]
[394.950221, "o", "- users\r\n"]
[394.954235, "o", ">>>Введите команду: "]
[414.120716, "o", "create_table users name:str\r\n"]
[414.122113, "o", "Ошибка: Таблица \"users\" уже существует.\r\n"]
[414.123296, "o", ">>>Введите команду: "]
[439.370584, "o", "create_table products price:float\r\n"]
[439.376161, "o", "Некорректное значение: price:float. Попробуйте снова.\r\n"]
[439.376883, "o", ">>>Введите команду: "]
[442.489353, "o", "drop_table users\r\n"]
[442.494662, "o", "Таблица \"users\" успешно удалена.\r\n"]
[442.495588, "o", ">>>Введите команду: "]
[452.109474, "o", "list_tables\r\n"]
[452.115556, "o", "Таблиц пока нет.\r\n"]
[452.117848, "o", ">>>Введите команду: "]
[455.423926, "o", "exit\r\n"]
[455.426756, "o", "Выход из программы.\r\n"]
[455.440813, "o", "bash-3.2$ "]
[458.310954, "o", "exit\r\n"]
[458.312185, "o", "exit\r\n"]
