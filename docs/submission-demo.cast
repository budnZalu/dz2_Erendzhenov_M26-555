[14.242213, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[14.242361, "o", ">>>Введите команду: "]
[15.298385, "o", "select from users where age=28\r\n"]
[15.299215, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[15.29989, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n+----+------+-----+-----------+\r\nЗаписей не найдено.\r\n"]
[15.300107, "o", ">>>Введите команду: "]
[16.356721, "o", "select from users where ID=1\r\n"]
[16.357165, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[16.357562, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[16.357849, "o", ">>>Введите команду: "]
