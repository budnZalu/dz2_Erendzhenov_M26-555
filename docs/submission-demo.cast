[4.707759, "o", "/Users/danir/.local/bin/uv run --locked database\r\n"]
[5.361743, "o", "\r\n***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу и её данные\r\n<command> insert into <таблица> values (<значение1>, ...) - создать запись\r\n<command> select from <таблица> [where <столбец> = <значение>] - прочитать записи\r\n<command> update <таблица> set <столбец> = <значение> where <столбец> = <значение> - обновить записи\r\n<command> delete from <таблица> where <столбец> = <значение> - удалить записи\r\n<command> info <таблица> - структура таблицы и количество записей\r\n<command> exit - выход из программы\r\n<command> he"]
[5.361837, "o", "lp - справочная информация\r\n\r\nТипы: int, str, bool. Строки — в кавычках; bool — true или false.\r\nID:int генерируется автоматически; в insert его передавать не нужно.\r\nУдаление таблиц и записей требует подтверждения: y — да, иначе отмена.\r\n\r\n>>>Введите команду: "]
[6.418471, "o", "create_table users name:str age:int is_active:bool\r\n"]
[6.41957, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[6.419842, "o", ">>>Введите команду: "]
[7.47653, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[7.477501, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[7.47957, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[7.479919, "o", ">>>Введите команду: "]
[8.53892, "o", "insert into users values (\"Anna\", 22, false)\r\n"]
[8.540357, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[8.541867, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[8.542064, "o", ">>>Введите команду: "]
[9.601177, "o", "select from users\r\n"]
[9.60191, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[9.993078, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  22 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[9.993232, "o", ">>>Введите команду: "]
[11.052781, "o", "select from users where age=28\r\n"]
[11.054053, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[11.054265, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[11.054486, "o", ">>>Введите команду: "]
[12.106845, "o", "select from users where age=28\r\n"]
[12.112068, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[12.112771, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[13.17398, "o", "insert into users values (\"Bad\", true, false)\r\n"]
[13.178685, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[13.178713, "o", "Ошибка валидации: Некорректное значение: True. Столбец \"age\" требует тип int.\r\n"]
[13.178928, "o", ">>>Введите команду: "]
[14.239112, "o", "update users set age=29 where ID=1\r\n"]
