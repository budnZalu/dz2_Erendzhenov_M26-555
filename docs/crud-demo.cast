[1.404035, "o", "demo$ "]
[2.161443, "o", "data"]
[2.161711, "o", "base\r\n"]
[2.540782, "o", "\r\n***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу и её данные\r\n<command> insert into <таблица> values (<значение1>, ...) - создать запись\r\n<command> select from <таблица> [where <столбец> = <значение>] - прочитать записи\r\n<command> update <таблица> set <столбец> = <значение> where <столбец> = <значение> - обновить записи\r\n<command> delete from <таблица> where <столбец> = <значение> - удалить записи\r\n<command> info <таблица> - структура таблицы и количество записей\r\n<command> exit - выход из программы\r\n"]
[2.54085, "o", "<command> help - справочная информация\r\n\r\nТипы: int, str, bool. Строки — в кавычках; bool — true или false.\r\nID:int генерируется автоматически; в insert его передавать не нужно.\r\n\r\n>>>Введите команду: "]
[3.301663, "o", "create_table users name:str age:int is_active:bool\r\n"]
[3.305112, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[3.305346, "o", ">>>Введите команду: "]
[4.061032, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[4.061933, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[4.061996, "o", ">>>Введите команду: "]
[4.822438, "o", "insert into users values (\"Anna\", 22, false)\r\n"]
[4.825928, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[4.826063, "o", ">>>Введите команду: "]
[5.586701, "o", "select from users\r\n"]
[5.887148, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  22 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[5.887255, "o", ">>>Введите команду: "]
[6.643276, "o", "select from users where age = 28\r\n"]
[6.644188, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[6.644473, "o", ">>>Введите команду: "]
[7.405077, "o", "update users set age=29, is_active=false where name=\"Sergei\"\r\n"]
[7.409674, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[7.409836, "o", ">>>Введите команду: "]
[8.165549, "o", "select from users where ID=1\r\n"]
[8.166467, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[8.166957, "o", ">>>Введите команду: "]
[8.922582, "o", "info users\r\n"]
[8.922836, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 2\r\n"]
[8.922898, "o", ">>>Введите команду: "]
[9.680326, "o", "exit\r\n"]
[9.681132, "o", "Выход из программы.\r\n"]
[9.703348, "o", "demo$ "]
