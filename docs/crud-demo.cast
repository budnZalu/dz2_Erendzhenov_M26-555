[1.397401, "o", "4.0 (from file:///private/var/folders/c6/q6hspv8s3_11hc72syxsskfm0000gn/T/primitive-db-crud-demo-mcobk1oz/primitive_db-0.4.0-py3-none-any.whl)\r\n + wcwidth==0.9.4\r\n"]
