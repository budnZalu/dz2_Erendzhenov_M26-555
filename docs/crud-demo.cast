[12.846424, "o", ">>>Введите команду: "]
[13.60722, "o", "select from users\r\n"]
[13.6094, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 2  | Anna |  22 |   False   |\r\n+----+------+-----+-----------+\r\n>>>Введите команду: "]
[14.370043, "o", "info users\r\n"]
